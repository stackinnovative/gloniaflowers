# Sanity (optional). Without SANITY_PROJECT_ID the build uses the committed data/*.json.
# Copy to .env.local for local builds; on Vercel add these under Project → Settings → Environment Variables.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only needed if the dataset is private (Sanity → API → Tokens, Viewer role).
SANITY_API_TOKEN=

# Google Places API (New) key for the reviews section. Optional: without it the section is hidden.
# Restrict it to "Places API (New)" in Google Cloud → Credentials.
GOOGLE_PLACES_API_KEY=
