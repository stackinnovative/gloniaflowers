{
  "name": "glonia-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-reviews.mjs --if-missing && node scripts/prepare-hero.mjs",
    "dev": "next dev",
    "sync": "node scripts/sync-sanity.mjs && node scripts/sync-reviews.mjs",
    "prebuild": "node scripts/sync-sanity.mjs && node scripts/sync-reviews.mjs && node scripts/prepare-hero.mjs",
    "build": "next build",
    "postbuild": "node scripts/finalize-export.mjs",
    "start": "node scripts/serve.mjs",
    "images:static": "node scripts/optimize-static-images.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
